{
  "name": "dlt_log-rs-devcontainer",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/rust:1.6.0": {
      "version": "nightly-2026-10-03",
      "profile": "default",
      "targets": ""
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {}
  },
  "mounts": [
    "source=dlt_log-rs-claude-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=dlt_log-rs-gh-${devcontainerId},target=/home/vscode/.config/gh,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "onCreateCommand": "./.devcontainer/onCreateCommand.sh",
  "postStartCommand": "./.devcontainer/postStartCommand.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "ryanluker.vscode-coverage-gutters"
      ]
    }
  }
}
